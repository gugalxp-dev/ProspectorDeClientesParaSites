# Copie para ".env" (o "npm run setup" faz isso e gera os segredos do app).
# NUNCA coloque este arquivo no Git. Credenciais também podem ser cadastradas em Admin > Integrações (ficam cifradas).

# ── Aplicação ──────────────────────────────────────────────────────────────
DATABASE_URL="file:./data/app.db"
# Endereço público HTTPS do sistema (necessário para o webhook da Meta). Ex.: https://prospector.suaempresa.com.br
APP_URL=""
# Gerados pelo "npm run setup" (32+ caracteres aleatórios). Não troque APP_ENCRYPTION_KEY depois de cadastrar credenciais no painel.
AUTH_SECRET=""
APP_ENCRYPTION_KEY=""

# ── IA: Anthropic / Claude (PENDENTE: preencher quando tiver a chave) ─────
# https://platform.claude.com/settings/keys  — sem chave, a IA funciona em modo SIMULADO.
ANTHROPIC_API_KEY=""
# Opcional: OpenAI como provedor alternativo e para embeddings da base de conhecimento.
# Sem ela, a busca na base usa palavras-chave (BM25), o que funciona bem.
OPENAI_API_KEY=""
# Opcional: "mock" força o modo simulado mesmo com chave.
AI_PROVIDER=""

# ── WhatsApp Business Cloud API / Meta (PENDENTE) ─────────────────────────
# Sem token e Phone Number ID, o WhatsApp funciona em modo SIMULADO (nada sai do computador).
# Token de acesso PERMANENTE de um System User com as permissões whatsapp_business_messaging e whatsapp_business_management.
WHATSAPP_TOKEN=""
# Meta Developers > seu app > WhatsApp > Configuração da API
WHATSAPP_PHONE_NUMBER_ID=""
WHATSAPP_BUSINESS_ACCOUNT_ID=""
# Meta Developers > seu app > Configurações do app > Básico > Chave secreta do app (valida a assinatura dos webhooks)
WHATSAPP_APP_SECRET=""
# Gerado pelo "npm run setup". Use o MESMO valor no campo "Verificar token" do webhook na Meta.
WHATSAPP_VERIFY_TOKEN=""
# Versão da Graph API. Confira a atual em https://developers.facebook.com/docs/graph-api/changelog
WHATSAPP_API_VERSION="v23.0"
# Opcional: "mock" força o simulado; "cloud" exige as credenciais acima;
# "baileys" usa a lib gratuita Baileys (conecta um número comum por QR code em Admin > WhatsApp).
# Baileys NÃO é oficial: a Meta pode banir o número, principalmente em contato frio.
WHATSAPP_MODO=""
# Porta local (127.0.0.1) da ponte entre o worker (dono da conexão Baileys) e o painel.
BAILEYS_PORTA="3011"

# ── Opcionais ──────────────────────────────────────────────────────────────
# Contato que o crawler informa no User-Agent (boa prática). Ex.: "contato@suaempresa.com.br"
CRAWLER_CONTATO=""
