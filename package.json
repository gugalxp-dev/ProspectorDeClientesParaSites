{
  "name": "client-prospector",
  "version": "0.1.0",
  "private": true,
  "description": "Plataforma de prospecção comercial B2B com IA, CRM e agente comercial via WhatsApp Cloud API.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "setup": "node scripts/setup.mjs",
    "iniciar": "node scripts/iniciar.mjs",
    "dev": "next dev --hostname 127.0.0.1",
    "build": "next build",
    "start": "next start --hostname 0.0.0.0 --port $PORT",    
    "db:push": "prisma db push && prisma generate",
    "db:studio": "prisma studio",
    "postinstall": "prisma generate",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "worker": "tsx src/worker/index.ts",
    "usuario": "tsx scripts/usuario.ts",
    "seed": "tsx scripts/seed.ts",
    "refiltrar": "tsx scripts/refiltrar.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.12.0",
    "@prisma/adapter-better-sqlite3": "^7.10.1",
    "@prisma/client": "^7.10.1",
    "baileys": "^7.0.0-rc14",
    "csv-parse": "^7.0.3",
    "dotenv": "^18.0.9",
    "link-preview-js": "^3.2.0",
    "lucide-react": "^1.61.0",
    "next": "^16.4.6",
    "qrcode": "^1.5.4",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^22.0.0",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "prisma": "^7.10.1",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vitest": "^5.0.5"
  }
}
